{
  "name": "dx-stats-data",
  "version": "1.0.0",
  "private": true,
  "description": "Daily DX metrics for the Pubky org, published as JSON via GitHub Pages.",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0",
    "npm": "^12.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "collect": "tsx scripts/collect-metrics.ts",
    "build": "tsx scripts/build-site.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "check": "npm run typecheck && npm test && npm run validate:data && npm run build"
  },
  "dependencies": {
    "js-yaml": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
